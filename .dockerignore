# .dockerignore

# Controle de versão
.git/
.gitignore

# Ambientes virtuais e caches Python
.venv/
venv/
env/
__pycache__
*.py[cod]
.pytest_cache/

# Segredos – nunca entram na imagem
.env

# Artefatos de dados – não são necessários no servidor
data/

# NOTA: notebooks/ e docs/ NÃO devem ser ignorados
# Eles fazem parte da documentação do projeto
# notebooks/  ← REMOVA ESTA LINHA
# docs/       ← REMOVA ESTA LINHA

# Ferramentas / SO
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log